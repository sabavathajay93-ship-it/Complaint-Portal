# Copy this file to ".env" and fill in the values. Never commit ".env".

# Port for local development (Render sets this automatically)
PORT=3000

# Admin login password for the dashboard
ADMIN_PASSWORD=Shivani@2026

# Random secret, at least 32 characters (used to sign admin tokens)
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=79a8d2a700be3ee4506427ce210a79e627703c634cec8a3f654f60582822a3b1

# PostgreSQL connection string
# Local example:  postgresql://postgres:YOUR_PASSWORD@localhost:5432/complaints_db
DATABASE_URL=postgresql://postgres:Ajay@2006@localhost:5432/complaints_db

# "false" for local PostgreSQL, "true" for hosted databases (Render, Neon, Supabase...)
DATABASE_SSL=false

# Websites allowed to call this API (comma separated, origins only, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
